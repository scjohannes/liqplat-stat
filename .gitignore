# R session and editor state
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
.Renviron
.vscode/settings.json

# Private, raw, and derived data. Public schemas and compact public artifacts
# remain trackable; do not add a blanket *.parquet or *.rds rule.
/data/private/*
!/data/private/.gitkeep
/data/raw/
/data/derived/
/data/analysis/
/data/cache/
*.duckdb

# Pipeline artifacts and model outputs
/artifacts/*
/results/
/logs/
/analysis/**/results/
/analysis/**/models/
/analysis/**/diagnostics/
/analysis/**/output/
/analysis/**/artifacts/
/analysis/**/_files/
/reports/_files/
/reports/_freeze/

# Quarto, knitr, and notebook renders
/_site/
/_freeze/
/.quarto/
*_cache/
*_files/
*.utf8.md
*.knit.md
*.rmarkdown
/analysis/**/*.html
/analysis/**/*.pdf

# Logs, caches, and local temporary files
*.log
*.out
*.tmp
*.bak
stan-progress.txt
nohup.out

# renv's machine-local library and staging area
/renv/library/
/renv/staging/
/renv/local/

# Package build/check products
/*.tar.gz
/*.Rcheck/

**/*.quarto_ipynb

# Local agent instructions and state
/AGENTS.md
/.agents/

# Obsolete root SAP/office/render leftovers (the current SAP lives under sap/)
/render-all.sh
/process-evluation-sap.pdf
/SAP.docx
/SAP.pdf

# Typst/HTML intermediates beside the trackable SAP source and PDF
/sap/SAP.pdf
/sap/SAP.typ
/sap/SAP_files/
