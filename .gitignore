# R session and editor state
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
.Renviron
.vscode/settings.json

# Data, schemas, and data documentation are local-only; never commit anything
# under data/.
/data/
*.duckdb

# Pipeline artifacts and model outputs
/artifacts/*
/results/
/logs/
/analysis/**/results/
/analysis/**/models/
/analysis/**/diagnostics/
/analysis/**/output/
/analysis/**/artifacts/
/analysis/**/_files/

# Report sources and renders are local-only; never commit anything under reports/
/reports/

# Quarto, knitr, and notebook renders
/_site/
/_freeze/
/.quarto/
*_cache/
*_files/
*.utf8.md
*.knit.md
*.rmarkdown
/analysis/**/*.html
/analysis/**/*.pdf

# Logs, caches, and local temporary files
*.log
*.out
*.tmp
*.bak
stan-progress.txt
nohup.out

# renv's machine-local library and staging area
/renv/library/
/renv/staging/
/renv/local/

# Package build/check products
/*.tar.gz
/*.Rcheck/

**/*.quarto_ipynb

# Local agent instructions and state
/AGENTS.md
/.agents/

# Obsolete root SAP/office/render leftovers (the current SAP lives under sap/)
/render-all.sh
/process-evluation-sap.pdf
/SAP.docx
/SAP.pdf

# Typst/HTML intermediates beside the trackable SAP source and PDF
/sap/SAP.pdf
/sap/SAP.typ
/sap/SAP_files/
tmp/
artifacts/

# Local archives of the analysis and report, and stray R graphics output
/reports.zip
/analysis.zip
Rplots.pdf
